# Soviet Jump Game - server (combined image), copied to .env and edited.
#
# Used by docker/docker-compose.yml.

# REQUIRED: your own retail copy of the game (no game code is shipped).
# Docker will refuse to start the gameserver role without this.
SJG_GAME_DIR=/path/to/Soviet Jump Game

# The address clients should use for the game server (this host / its DNS name).
# Advertised in the server browser heartbeat.
SJG_PUBLIC_HOST=sjg.dnd.wtf

# UDP port for gameplay.
SJG_GAME_PORT=42010

# Map hosted by the headless server.
SJG_MATCH_MAP=Soviet Jump Game Map A

# Backend auth/config.
SJG_ACCOUNT_GROUP=Administrator
SJG_JWT_SECRET=change-me

# Optional: always-listed servers, "host:port[:Name],..." (no heartbeat needed).
SJG_STATIC_SERVERS=

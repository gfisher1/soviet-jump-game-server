#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Headless Soviet Jump Game server (the "gameserver" role of the combined image).
#
# The game IS the server: there is no separate dedicated-server binary. This
# launches the retail client under Wine; the game then boots its headless
# manager and hosts a Bolt session on UDP ${SJG_GAME_PORT}.
#
# NO GAME CODE IS SHIPPED. Mount your own copy of the game at ${SJG_GAME_DIR}.
# ---------------------------------------------------------------------------
set -euo pipefail

GAME_DIR="${SJG_GAME_DIR:-/game}"
MAP="${SJG_MATCH_MAP:-Soviet Jump Game Map A}"
PORT="${SJG_GAME_PORT:-42010}"

export WINEPREFIX="${WINEPREFIX:-/wine}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-winhttp=n,b}"
export WINEDEBUG="${WINEDEBUG:--all}"
export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"

if [ ! -f "${GAME_DIR}/SovietJumpGame.exe" ]; then
    echo "[sjg] no game files found: ${GAME_DIR}/SovietJumpGame.exe" >&2
    echo "[sjg] mount your retail game folder there (see the wiki: Deployment)." >&2
    exit 1
fi

mkdir -p "${WINEPREFIX}"

# The game treats a ~HeadlessDebug.txt marker next to the executable as
# "run headless" (Headless.IsHeadless()). Using the marker instead of Unity's
# -batchmode/-nographics avoids Unity's flaky "Failed to create batch mode
# window: Success." startup failure under Wine, which made the container
# crash-loop. Unity is run windowed on a private Xvfb instead.
if ! touch "${GAME_DIR}/~HeadlessDebug.txt" 2>/dev/null; then
    echo "[sjg] warning: could not create ${GAME_DIR}/~HeadlessDebug.txt (game dir not writable?)" >&2
fi

XVFB_DISPLAY=:99
Xvfb "${XVFB_DISPLAY}" -screen 0 1280x1024x24 -nolisten tcp >/tmp/xvfb.log 2>&1 &
XVFB_PID=$!
cleanup() { kill "${XVFB_PID}" 2>/dev/null || true; }
trap cleanup EXIT INT TERM

XVFB_SOCKET="/tmp/.X11-unix/X${XVFB_DISPLAY#:}"
for _ in $(seq 1 100); do
    [ -e "${XVFB_SOCKET}" ] && break
    sleep 0.2
done

if [ ! -e "${XVFB_SOCKET}" ]; then
    echo "[sjg] Xvfb did not come up on ${XVFB_DISPLAY}; see /tmp/xvfb.log" >&2
    cat /tmp/xvfb.log >&2 || true
    exit 1
fi

export DISPLAY="${XVFB_DISPLAY}"

cd "${GAME_DIR}"

echo "[sjg] starting headless server: map='${MAP}', udp=${PORT}, display=${DISPLAY}, wineprefix=${WINEPREFIX}"

exec wine SovietJumpGame.exe -batchmode "${MAP}"

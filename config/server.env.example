# Copy to .env and tweak. Used by docker/docker-compose.yml.

# Address handed to clients for the game server (your host's reachable IP/name).
SJG_PUBLIC_HOST=127.0.0.1

# UDP port the headless game server listens on.
SJG_GAME_PORT=42010

# ApiAccountType returned by /authenticate: Normal | VIP | Administrator
SJG_ACCOUNT_GROUP=Administrator

# HS256 secret for the issued JWT (client does not verify it).
SJG_JWT_SECRET=sjg-local-secret

# Copy to .env and tweak. Used by docker/docker-compose.yml and the run scripts.

# Address handed to clients for the game server (your host's reachable IP/name).
SJG_PUBLIC_HOST=127.0.0.1

# UDP port the headless game server listens on.
SJG_GAME_PORT=42010

# ApiAccountType returned by /authenticate: Normal | VIP | Administrator
SJG_ACCOUNT_GROUP=Administrator

# HS256 secret for the issued JWT (client does not verify it).
SJG_JWT_SECRET=sjg-local-secret

# Always-list the browser servers, as host:port[:Name] entries (comma/semicolon separated).
# No heartbeat required. Example:
# SJG_STATIC_SERVERS=192.168.1.50:42010:Comrade's LAN Server,10.0.0.9:42011
SJG_STATIC_SERVERS=

# Listen address/port for the run scripts.
HOST=0.0.0.0
PORT=8080
